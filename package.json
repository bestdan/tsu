{
  "name": "tsutils",
  "version": "0.24.0",
  "description": "TypeScript command line utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsutils": "./dist/cli.js",
    "tsu": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src && prettier --check \"src/**/*.ts\"",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm audit --fix"
  },
  "keywords": [
    "cli",
    "typescript",
    "utilities"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "listr2": "^9.0.5"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=3.0.0 <3.1.4": "3.1.4",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@<4.1.1": "4.1.1",
      "ajv@>=6.0.0 <6.14.0": "6.14.0",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4"
    }
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  }
}
