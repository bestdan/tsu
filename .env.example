# DataDog Configuration
# To enable DataDog logging, copy this file to .env and set your API key

# Your DataDog API key (required for DataDog logging)
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your_api_key_here

# DataDog site (optional, defaults to datadoghq.com)
# Common values: datadoghq.com, datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com
DD_SITE=datadoghq.com

# Environment for tagging logs (optional)
NODE_ENV=development
